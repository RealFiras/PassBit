{
  "manifest_version": 3,
  "name": "PassBit - Zero-Knowledge Entropy & Breach Detector",
  "version": "1.2.0",
  "description": "Arabic-first private password checker, generator, and encrypted local favorites by Firas.",
  "author": "Firas",
  "minimum_chrome_version": "88",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "PassBit — password security",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["entropy.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
